#!/usr/bin/env bash
#
# Deploy and run Vector on a single machine.
#
#   ./vectorctl setup    first run: check the box, ask for what it needs, start the stack
#   ./vectorctl update   pull, rebuild, restart, and say what changed
#   ./vectorctl status   what is running, what version, what the SDE is on
#
# Everything it writes lives in .env next to this script. It never edits the compose file.

set -euo pipefail

cd "$(dirname "$0")"
ENV_FILE=.env
COMPOSE=(docker compose --profile full)

bold() { printf '\033[1m%b\033[0m\n' "$1"; }
ok()   { printf '  \033[32m✓\033[0m %s\n' "$1"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$1"; }
bad()  { printf '  \033[31m✗\033[0m %s\n' "$1"; }
die()  { printf '\n\033[31m%s\033[0m\n' "$1" >&2; exit 1; }

# --- reading and writing .env ------------------------------------------------

env_get() {
	[ -f "$ENV_FILE" ] || return 0
	sed -n "s/^$1=//p" "$ENV_FILE" | tail -1
}

# Replace the line if it is there, append it if it is not. Values are written as-is; a
# password with a `#` or a space in it still round-trips because nothing here splits on them.
env_set() {
	local key=$1 value=$2
	touch "$ENV_FILE"
	if grep -q "^$key=" "$ENV_FILE"; then
		local tmp
		tmp=$(mktemp)
		grep -v "^$key=" "$ENV_FILE" > "$tmp"
		printf '%s=%s\n' "$key" "$value" >> "$tmp"
		mv "$tmp" "$ENV_FILE"
	else
		printf '%s=%s\n' "$key" "$value" >> "$ENV_FILE"
	fi
	chmod 600 "$ENV_FILE"
}

# Prompt with the current value as the default, so re-running setup is safe.
ask() {
	local key=$1 prompt=$2 secret=${3:-} current answer
	current=$(env_get "$key")
	if [ -n "$current" ] && [ -n "$secret" ]; then
		read -r -p "$prompt [keep existing]: " answer
	elif [ -n "$current" ]; then
		read -r -p "$prompt [$current]: " answer
	else
		read -r -p "$prompt: " answer
	fi
	env_set "$key" "${answer:-$current}"
}

# --- checks ------------------------------------------------------------------

check_docker() {
	command -v docker >/dev/null || die "Docker is not installed. See https://docs.docker.com/engine/install/"
	docker compose version >/dev/null 2>&1 || die "This needs Docker Compose v2 (the 'docker compose' subcommand)."
	docker info >/dev/null 2>&1 || die "Docker is installed but not running, or this user cannot reach it."
	ok "Docker $(docker version --format '{{.Server.Version}}') with compose v2"
}

check_disk() {
	local avail
	avail=$(df -Pk . | awk 'NR==2 {print int($4/1024/1024)}')
	if [ "$avail" -lt 5 ]; then
		warn "${avail}GB free here. A build plus the database wants 5GB or so."
	else
		ok "${avail}GB free"
	fi
}

# Whether something other than our own stack is already holding a port.
port_holder() {
	local port=$1
	if command -v ss >/dev/null; then
		ss -ltnH "sport = :$port" 2>/dev/null | head -1
	elif command -v lsof >/dev/null; then
		lsof -nP -iTCP:"$port" -sTCP:LISTEN 2>/dev/null | sed -n 2p
	fi
}

check_ports() {
	local ours busy=0
	ours=$("${COMPOSE[@]}" ps -q caddy 2>/dev/null || true)
	for port in "$@"; do
		if [ -n "$(port_holder "$port")" ]; then
			if [ -n "$ours" ]; then
				ok "port $port is held by this stack's Caddy"
			else
				bad "port $port is already in use: $(port_holder "$port")"
				busy=1
			fi
		else
			ok "port $port is free"
		fi
	done
	[ "$busy" -eq 0 ] || die "Free those ports (or stop whatever is on them) and run this again."
}

public_ip() {
	curl -fsS --max-time 5 https://api.ipify.org 2>/dev/null ||
		curl -fsS --max-time 5 https://ifconfig.me 2>/dev/null || true
}

resolves_to() {
	local host=$1
	if command -v dig >/dev/null; then
		dig +short "$host" A; dig +short "$host" AAAA
	elif command -v getent >/dev/null; then
		getent ahosts "$host" | awk '{print $1}' | sort -u
	else
		# macOS without dig: good enough to tell "resolves" from "does not".
		ping -c1 -t1 "$host" 2>/dev/null | sed -n 's/.*(\([0-9.]*\)).*/\1/p' | head -1
	fi
}

check_dns() {
	local domain=$1 ip addrs
	[ -n "$domain" ] || return 0
	addrs=$(resolves_to "$domain" | tr '\n' ' ')
	if [ -z "${addrs// /}" ]; then
		bad "$domain does not resolve yet. Point an A record at this server first."
		die "Certificates cannot be issued for a name that does not resolve."
	fi
	ip=$(public_ip)
	if [ -z "$ip" ]; then
		warn "$domain resolves to $addrs (could not work out this machine's public address to compare)"
	elif [[ " $addrs " == *" $ip "* ]]; then
		ok "$domain resolves to $ip, which is this machine"
	else
		warn "$domain resolves to $addrs but this machine looks like $ip."
		warn "That is fine behind Cloudflare or a NAT, and fatal otherwise: Let's Encrypt has to reach port 80 here."
	fi
}

check_repo() {
	git rev-parse --git-dir >/dev/null 2>&1 || { warn "not a git checkout, skipping the version check"; return 0; }
	git fetch --quiet origin 2>/dev/null || { warn "could not reach origin, skipping the version check"; return 0; }
	local behind dirty
	behind=$(git rev-list --count HEAD..@{u} 2>/dev/null || echo 0)
	dirty=$(git status --porcelain | wc -l | tr -d ' ')
	[ "$dirty" -eq 0 ] || warn "$dirty uncommitted change(s) here; an update will not touch them"
	if [ "$behind" -gt 0 ]; then
		warn "$behind commit(s) behind origin. ./vectorctl update takes them."
	else
		ok "up to date with origin"
	fi
}

check_sde() {
	local out
	out=$("${COMPOSE[@]}" run --rm --no-deps -T api vector sde-status 2>/dev/null || true)
	case "$out" in
		*"update_available=yes"*) warn "a newer SDE build is out ($(sed -n 's/^latest=//p' <<<"$out")); it loads on the next restart" ;;
		*"update_available=no"*)  ok "SDE is current ($(sed -n 's/^loaded=\([0-9]*\).*/\1/p' <<<"$out"))" ;;
		*) warn "could not check the SDE build (is the stack built? try ./vectorctl update)" ;;
	esac
}

# --- commands ----------------------------------------------------------------

cmd_setup() {
	bold "Checking this machine"
	check_docker
	check_disk
	check_repo

	bold "\nWhat this deployment needs"
	ask VECTOR_DOMAIN "Public domain (blank for plain http on this machine)"
	local domain http https
	domain=$(env_get VECTOR_DOMAIN)
	if [ -n "$domain" ]; then
		http=80; https=443
	else
		http=$(env_get HTTP_PORT); http=${http:-8080}; https=$(env_get HTTPS_PORT); https=${https:-8443}
	fi
	env_set HTTP_PORT "$http"
	env_set HTTPS_PORT "$https"

	echo
	echo "  EVE SSO application (https://developers.eveonline.com/applications)."
	if [ -n "$domain" ]; then
		echo "  Its callback URL must be exactly: https://$domain/auth/callback"
	else
		echo "  Its callback URL must be exactly: http://localhost:$http/auth/callback"
	fi
	ask EVE_CLIENT_ID "  Client ID"
	ask EVE_CLIENT_SECRET "  Secret" secret
	if [ -n "$domain" ]; then
		env_set EVE_REDIRECT_URI "https://$domain/auth/callback"
	else
		env_set EVE_REDIRECT_URI "http://localhost:$http/auth/callback"
	fi

	# A database nobody chose a password for is a database with the password in the README.
	if [ -z "$(env_get POSTGRES_PASSWORD)" ]; then
		env_set POSTGRES_PASSWORD "$(head -c 32 /dev/urandom | base64 | tr -d '/+=' | head -c 32)"
		ok "generated a database password"
	fi

	bold "\nChecking the network"
	check_dns "$domain"
	check_ports "$http" "$https"

	bold "\nBuilding"
	"${COMPOSE[@]}" build
	bold "\nStarting"
	"${COMPOSE[@]}" up -d

	bold "\nAfter the first boot"
	echo "  The API seeds the static data on its first start, which takes a few minutes."
	echo "  Follow it with: docker compose --profile full logs -f api"
	if [ -n "$domain" ]; then
		echo "  Then open https://$domain"
	else
		echo "  Then open http://localhost:$http"
	fi
}

cmd_update() {
	bold "Updating"
	check_docker
	local before after
	before=$(git rev-parse --short HEAD 2>/dev/null || echo unknown)
	if git rev-parse --git-dir >/dev/null 2>&1; then
		git pull --ff-only || die "Could not fast-forward. Sort the working tree out first."
	fi
	after=$(git rev-parse --short HEAD 2>/dev/null || echo unknown)
	if [ "$before" = "$after" ]; then
		ok "already on $after"
	else
		ok "$before → $after"
	fi

	"${COMPOSE[@]}" build
	# Migrations and any SDE re-seed run on boot, so a restart is the whole of it.
	"${COMPOSE[@]}" up -d
	check_sde
	ok "running"
}

cmd_status() {
	bold "Containers"
	"${COMPOSE[@]}" ps
	bold "\nVersion"
	check_repo
	bold "\nStatic data"
	check_sde
	local domain
	domain=$(env_get VECTOR_DOMAIN)
	if [ -n "$domain" ]; then
		bold "\nPublic"
		if curl -fsS --max-time 5 -o /dev/null "https://$domain/api/server-status"; then
			ok "https://$domain answers"
		else
			bad "https://$domain does not answer"
		fi
	fi
}

case "${1:-help}" in
	setup)  cmd_setup ;;
	update) cmd_update ;;
	status) cmd_status ;;
	*)
		sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
		;;
esac
