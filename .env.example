# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.

# EVE Online SSO application — register at https://developers.eveonline.com/
# In dev the whole app (including /auth) lives on the vite origin (:5173, proxied to the
# API), so the callback must be registered for :5173. Behind Caddy it's the public origin.
EVE_CLIENT_ID=your-client-id
EVE_CLIENT_SECRET=your-client-secret
EVE_REDIRECT_URI=http://localhost:5173/auth/callback

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://vector:vector@localhost:5432/vector

# Killmail ingest + threat analysis (polls zKillboard when enabled). Enabling it also fills
# in the last 90 days from EVE Ref's archives on boot, once, for whatever is missing.
# ZKB_LISTEN=1
# KILLMAIL_BACKFILL_DAYS=90

# Where ESI lives. Unset means the real thing. The e2e suite sets it to
# `frontend/e2e/esi-stub.mjs`, which proxies anything it has not been scripted through to
# real ESI, so it is safe in front of a dev stack too: set this (and run `node
# e2e/esi-stub.mjs` from `frontend/`) and the ESI-driven tests will run against a stack you
# started yourself instead of skipping.
# ESI_BASE_URL=http://127.0.0.1:3999

# How often to ask ESI whether Tranquility is up (seconds). Everything that polls ESI is
# gated on the answer, so a shorter interval means a faster recovery after downtime.
# SERVER_STATUS_POLL_SECS=60

# How often to mirror the raidable-skyhook list from ESI (seconds).
# SKYHOOK_POLL_SECS=300

# Discord. All five are needed for the bot half (account linking and slash commands);
# leave them unset and the alerts UI still works with channel webhooks.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://localhost:5173/discord/callback
# DISCORD_PUBLIC_KEY=
# DISCORD_APPLICATION_ID=
# Only needed to post as the bot (direct messages, bot channels).
# DISCORD_BOT_TOKEN=
