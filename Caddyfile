# Single origin: backend paths go to Axum, everything else to SvelteKit.
# WebSocket upgrades pass through reverse_proxy automatically.
#
# The site address comes from VECTOR_DOMAIN. Set it to a real domain and Caddy gets a
# certificate for it and redirects http to https on its own; leave it unset and this serves
# plain http on :80, which is what local full-stack testing wants.
{$VECTOR_DOMAIN::80} {
	handle /api/* {
		reverse_proxy api:3000
	}
	handle /ws/* {
		reverse_proxy api:3000
	}
	handle /auth/* {
		reverse_proxy api:3000
	}
	handle {
		reverse_proxy web:3001
	}
}
