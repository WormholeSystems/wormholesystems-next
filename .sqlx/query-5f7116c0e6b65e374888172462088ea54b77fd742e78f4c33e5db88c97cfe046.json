  "query": "select e.id, e.map_id, e.character_id, c.name as \"character_name?\",\n                  e.kind, e.label, e.entries_count, e.parent_id, e.is_step, e.created_at\n           from map_events e\n           left join characters c on c.id = e.character_id\n           where e.map_id = $1\n           order by e.id desc\n           limit $2",
