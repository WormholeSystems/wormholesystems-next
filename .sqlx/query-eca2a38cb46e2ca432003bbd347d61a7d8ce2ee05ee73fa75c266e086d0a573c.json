  "query": "select s.online,\n                  s.ship_type_id,\n                  ss.name as \"solar_system?\",\n                  s.ship_name,\n                  t.name as \"ship_type?\"\n           from character_status s\n           left join solar_systems ss on ss.id = s.solar_system_id\n           left join types t on t.id = s.ship_type_id\n           where s.character_id = $1",
