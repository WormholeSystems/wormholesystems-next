{
  "db_name": "PostgreSQL",
  "query": "\n        select s.id,\n               s.name,\n               s.security_status as \"security!\",\n               r.name            as \"region!\",\n               s.wormhole_class_id\n        from solar_systems s\n        join regions r on r.id = s.region_id\n        where s.name ilike $1\n        order by (s.name ilike $2) desc, length(s.name), s.name\n        limit 30\n        ",
