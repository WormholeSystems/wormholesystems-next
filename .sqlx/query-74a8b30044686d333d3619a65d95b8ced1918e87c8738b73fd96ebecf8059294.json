{
  "db_name": "PostgreSQL",
  "query": "select e.id, e.map_alert_id, a.name as \"alert_name?\", e.kind, e.detail, e.created_at,\n                  (select c.name from characters c\n                    where c.user_id = e.actor_user_id\n                    order by c.id limit 1) as \"actor?\"\n           from map_alert_events e\n           left join map_alerts a on a.id = e.map_alert_id\n           where e.map_id = $1\n           order by e.id desc\n           limit $2",
