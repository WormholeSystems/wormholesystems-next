  "query": "select a.name, a.kind, a.is_active, a.disabled_reason, m.name as map_name\n         from map_alerts a\n         join maps m on m.id = a.map_id\n         where a.created_by_user_id = $1 and ($2::bigint is null or a.map_id = $2)\n         order by m.name, a.name",
